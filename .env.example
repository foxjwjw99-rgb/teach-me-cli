# Copy this file to .env.local and fill in your values.
# teach-me-cli configuration
# (All values are optional unless noted otherwise)

# ── Anthropic API ──────────────────────────────────────────────────────────────
# Required if you're using the Anthropic LLM backend directly.
ANTHROPIC_API_KEY=

# ── OmniVoice TTS ─────────────────────────────────────────────────────────────
# Path to your reference audio file for voice cloning.
# Required for audio narration generation; skip this if you use --no-audio.
OMNIVOICE_REF_AUDIO=/path/to/your/voice-clone-reference.wav

# Reference text that matches the audio file above.
# OMNIVOICE_REF_TEXT=这是现在我们学校流行的装饰品了。

# Voice instruction hint passed to OmniVoice.
# OMNIVOICE_INSTRUCT=female, very low pitch

# Playback speed (default: 0.9).
# OMNIVOICE_SPEED=0.9

# Style guidance for the synthesised voice.
# OMNIVOICE_STYLE=請用台灣國語的感覺說話，使用台灣繁體中文常用詞。

# ── Output ────────────────────────────────────────────────────────────────────
# Default output directory (default: ./output).
# OUTPUT_DIR=./output

# Comma-separated list of formats: pptx,json,html (default: pptx,json).
# OUTPUT_FORMATS=pptx,json

# ── LLM ───────────────────────────────────────────────────────────────────────
# Override the model used for generation.
# LLM_MODEL=claude-opus-4-5

# LLM provider: anthropic | openclaw | openai | gemini (default: anthropic).
# LLM_PROVIDER=anthropic
